              <profiles>
                <profile name="Lanza del Cazador" id="e097-035f-f4cd-39ed" hidden="false" typeId="6838-76bd-df50-3dbe" typeName="Equipamiento">
                  <characteristics>
                    <characteristic name="Descripción" typeId="8943-2b21-512c-8bb6">Estas Armas añadirán +4 a cualquier tirada de Asalto, pero la miniatura perdedora siempre será asesinada cuando se usen.
Alcance a 2&quot; para atacar.</characteristic>
