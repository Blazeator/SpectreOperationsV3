            <selectionEntry name="Lanza del Cazador" id="bc9e-e176-ac5c-4979" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="42c0-cc3b-dc75-d6aa-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
