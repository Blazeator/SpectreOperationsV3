    <selectionEntry name="Predator" id="b12f-8a1b-0d23-0a36" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Alienigenas" id="6faa-eaf1-9b37-5ad9" hidden="false" primary="true" targetId="3858-a699-2bdd-b350"/>
      </categoryLinks>
      <constraints>
        <constraint id="67c2-ad40-d306-a1bc" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <profiles>
        <profile name="Predator" id="bde1-f3f8-278e-f622" hidden="false" typeId="9e34-ec9a-2063-cc02" typeName="Combatiente">
          <characteristics>
            <characteristic name="Movimiento" typeId="62b0-2d44-1adc-2daf">6</characteristic>
            <characteristic name="Balística" typeId="e9bf-d1ec-4f7e-b6fb">6</characteristic>
            <characteristic name="Percepción" typeId="319e-be1e-4f04-0f03">6</characteristic>
            <characteristic name="Estrés" typeId="7bd1-d92a-d8df-8b7f">6</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Imparable" id="d635-16ab-8328-2299" hidden="false">
          <description>No puede ser eliminado al instante con un arma. Si la tirada de Letalidad tiene éxito, se realiza una tirada en la tabla de heridas criticas.</description>
        </rule>
        <rule name="Digno Oponente" id="1857-f488-e216-fc6b" hidden="false">
          <description>Detecta automáticamente unidades Encubiertas, pero nunca atacará a un enemigo desarmado.</description>
        </rule>
        <rule name="Cazador" id="226a-72ef-458c-4bf0" hidden="false">
          <description>Cada vez que elimina a un enemigo a distancia o en Asalto, puede moverse hasta el cadáver de ese enemigo para recolectar su cráneo.
El Predator ganará sin consigue todos los cráneos de sus enemigos.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Equipamiento" id="aa11-81ea-2a98-1d9f" hidden="false">
          <selectionEntries>
            <selectionEntry name="Camuflaje Adaptativo" id="aac5-e4b3-1085-906a" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="93d9-7e3f-2637-69ff-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
                <constraint id="93d9-7e3f-2637-69ff-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Camuflaje Adaptativo" id="3361-1d67-9ae3-42bf" hidden="false" typeId="6838-76bd-df50-3dbe" typeName="Equipamiento">
                  <characteristics>
                    <characteristic name="Descripción" typeId="8943-2b21-512c-8bb6">Todos los ataques a distancia sufren un penalizador de -3 si el Predator no se ha movido en su fase y -2 si se ha movido.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Armadura Alienígena" id="9263-ec2f-ba03-e6fb" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="dcf9-baf2-cb56-27ac-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
                <constraint id="dcf9-baf2-cb56-27ac-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Armadura Alienígena" id="0476-7efc-8249-87df" hidden="false" typeId="6838-76bd-df50-3dbe" typeName="Equipamiento">
                  <characteristics>
                    <characteristic name="Descripción" typeId="8943-2b21-512c-8bb6">Blindaje 5, al igual que un vehículo.
Si la tirada de penetración iguala el valor de armadura, resulta en una Herida
Si la tirada de penetración es mayor que el valor de armadura, se realiza una tirada de Herida Crítica.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Máscara de Visión Avanzada" id="dc3f-88c3-0de8-9a3d" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="d739-8325-d7e5-6d8e-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
                <constraint id="d739-8325-d7e5-6d8e-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Máscara de Visión Avanzada" id="dcdb-ce66-15b8-9b9c" hidden="false" typeId="6838-76bd-df50-3dbe" typeName="Equipamiento">
                  <characteristics>
                    <characteristic name="Descripción" typeId="8943-2b21-512c-8bb6">+2 a cualquier ataque a distancia con el Proyector de Plasma y con la Pistola de Dardos. 
No puede ser Aturdido.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Dispositivo de Antimateria" id="2341-afb9-2fd8-fce2" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="75ad-96bf-c205-03da-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
                <constraint id="75ad-96bf-c205-03da-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Dispositivo de Antimateria" id="accf-79db-c29d-a887" hidden="false" typeId="6838-76bd-df50-3dbe" typeName="Equipamiento">
                  <characteristics>
                    <characteristic name="Descripción" typeId="8943-2b21-512c-8bb6">Si cualquiera de sus atributos llega a 1, puede optar por activar este dispositivo. En D3 Turnos, explota con el perfil de un IED.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Kit Médico Avanzado" id="e155-c4cc-d2ff-45f3" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="8d21-917a-cbbf-545d-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
                <constraint id="8d21-917a-cbbf-545d-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Kit Médico Avanzado" id="8483-bb45-f81b-837e" hidden="false" typeId="6838-76bd-df50-3dbe" typeName="Equipamiento">
                  <characteristics>
                    <characteristic name="Descripción" typeId="8943-2b21-512c-8bb6">Se puede usar como una Acción, recuperando 2 puntos de sus atributos. No puede mover no realizar ataques a distancia ese turno.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
