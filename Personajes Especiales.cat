  <selectionEntries>
    <selectionEntry name="Baba Yaga" id="8798-965f-350f-872d" hidden="false" import="true" type="model">
      <categoryLinks>
        <categoryLink name="Humanos" id="1228-2ac6-830a-caf5" hidden="false" primary="true" targetId="b8c7-3c69-5b5f-83bc"/>
      </categoryLinks>
      <constraints>
        <constraint id="acdb-bc69-f9e3-1031" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="Recursos" typeId="e097-af1e-bf07-f031" value="200"/>
      </costs>
      <profiles>
        <profile name="Baba Yaga" id="e5e1-a0a1-f218-cb7c" hidden="false" typeId="9e34-ec9a-2063-cc02" typeName="Combatiente">
          <characteristics>
            <characteristic name="Movimiento" typeId="62b0-2d44-1adc-2daf">6</characteristic>
            <characteristic name="Balística" typeId="e9bf-d1ec-4f7e-b6fb">3</characteristic>
            <characteristic name="Percepción" typeId="319e-be1e-4f04-0f03">6</characteristic>
            <characteristic name="Estrés" typeId="7bd1-d92a-d8df-8b7f">2</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Momentum +4" id="fc07-5a8b-847f-69b0" hidden="false">
          <description>Genera 4 Momentum por Turno</description>
        </rule>
        <rule name="No conoce el miedo" id="13e1-e674-c7e2-5f51" hidden="false">
          <description>Nunca realiza Chequeos de Estrés tras recibir una Acción de Combate</description>
        </rule>
        <rule name="No se muere..." id="7b48-9f59-8a28-d60d" hidden="false">
          <description>Por cada tirada de Letalidad exitosa contra él, Baba yaga pierde 1 punto de Movimiento (en lugar de ser retirado de la mesa).
En el momento en que su Movilidad se reduzca a 0, es eliminado finalmente.</description>
        </rule>
        <rule name="Máquina de Matar" id="caa1-1b7b-0b86-d843" hidden="false">
          <description>Cada vez que una Acción de Combate resulte en al menos un enemigo eliminado, Baba Yaga puede realizar gratis otra Acción de Combate o de Asalto (esta es una excepción a la regla de no poder repetir la misma Acción de seguido)</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Armas" id="5904-f598-d941-e7cc" hidden="false">
          <constraints>
            <constraint id="73c1-8085-421f-635e" field="selections" includeChildSelections="false" message="Máximo 2 Armas" scope="parent" shared="true" type="max" value="2"/>
          </constraints>
