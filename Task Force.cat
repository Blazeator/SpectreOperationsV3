                <characteristic name="Descripción" typeId="2b3c-4ce9-3d0b-24d2">Humo marcador / IR para enmascarar o marcar una posición</characteristic>
                <characteristic name="Efecto" typeId="77dd-688d-97d4-78a1">Cualquier perfil de Humo</characteristic>
              </characteristics>
            </profile>
            <profile name="Nivel 1 - Refuerzos - Ligero" typeId="9bc6-e12d-f350-b01a" typeName="Escaladas" hidden="false" id="6881-acdb-5ea4-b98f">
              <characteristics>
                <characteristic name="Descripción" typeId="2b3c-4ce9-3d0b-24d2">Despliega una Unidad Ligera o de Reconocimiento (&lt;400 Recursos) desde la Reserva</characteristic>
