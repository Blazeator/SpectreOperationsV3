              <characteristics>
                <characteristic name="Descripción" typeId="2b3c-4ce9-3d0b-24d2">Despliege de UAV. Todas las Unidades aliadas ganas +2 en tiradas de Percepción y Detección.</characteristic>
                <characteristic name="Efecto" typeId="77dd-688d-97d4-78a1">Dura hasta el siguiente Turno</characteristic>
              </characteristics>
            </profile>
