            <profile name="Nivel 4 - Refuerzos: Muchedumbre" typeId="9bc6-e12d-f350-b01a" typeName="Escaladas" hidden="false" id="5c90-05d9-296a-526f">
              <characteristics>
                <characteristic name="Descripción" typeId="2b3c-4ce9-3d0b-24d2">Despliega 2-3 Unidades de Milicianos desde la reserva</characteristic>
                <characteristic name="Efecto" typeId="77dd-688d-97d4-78a1">Deben aparecer en una carretera, un callejón o un garaje. Aplica Reglas de Refuerzos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
