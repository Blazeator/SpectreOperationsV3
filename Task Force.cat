      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Nivel 1 - Herramientas Tácticas" hidden="false" id="3fa6-2051-7d08-b939">
          <profiles>
            <profile name="Nivel 1 - ISTAR UAV" typeId="9bc6-e12d-f350-b01a" typeName="Escaladas" hidden="false" id="689d-65f7-ebb8-a355">
              <characteristics>
                <characteristic name="Descripción" typeId="2b3c-4ce9-3d0b-24d2">Conexión persistente con un Dron. todos los aliados gana +1 a la Percepción y +1 a Detección durante 1 Turno.</characteristic>
                <characteristic name="Efecto" typeId="77dd-688d-97d4-78a1">Persistente</characteristic>
              </characteristics>
            </profile>
            <profile name="Nivel 1 - Dron de Reconocimiento de Combate" typeId="9bc6-e12d-f350-b01a" typeName="Escaladas" hidden="false" id="8915-a13a-f06f-1e6c">
              <characteristics>
                <characteristic name="Descripción" typeId="2b3c-4ce9-3d0b-24d2">Despliege de UAV. Todas las Unidades aliadas ganas +2 en tiradas de Percepción y Detección.</characteristic>
                <characteristic name="Efecto" typeId="77dd-688d-97d4-78a1">Dura hasta el siguiente Turno</characteristic>
              </characteristics>
            </profile>
            <profile name="Nivel 1 - Ataque de Mortero Ligero" typeId="9bc6-e12d-f350-b01a" typeName="Escaladas" hidden="false" id="da39-bb5a-4795-f419">
              <characteristics>
                <characteristic name="Descripción" typeId="2b3c-4ce9-3d0b-24d2">Ataque de Mortero Ligero coordinado con Telémetro Láser</characteristic>
