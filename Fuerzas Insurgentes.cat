                <characteristic name="Descripción" typeId="2b3c-4ce9-3d0b-24d2">Un Tirador de la Milicia intenta asesinar al Comandante enemigo.</characteristic>
                <characteristic name="Efecto" typeId="77dd-688d-97d4-78a1">Perfil de Francotirador Medio a Alcance Extremo</characteristic>
