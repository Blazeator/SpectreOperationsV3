            <profile name="Nivel 6 - Movilización en Masa" typeId="9bc6-e12d-f350-b01a" typeName="Escaladas" hidden="false" id="4ac0-9aec-40f2-4cc6">
              <characteristics>
                <characteristic name="Descripción" typeId="2b3c-4ce9-3d0b-24d2">Hasta 3 Unidades llegan desde fuera de los limites del tablero. Generalmente, inexpertos pero numerosos.</characteristic>
                <characteristic name="Efecto" typeId="77dd-688d-97d4-78a1">Aparecen desde cualquier zona accesible por civiles. Aplican reglas de Refuerzos.</characteristic>
              </characteristics>
            </profile>
            <profile name="Nivel 6 - Ataque de Armas Químicas" typeId="9bc6-e12d-f350-b01a" typeName="Escaladas" hidden="false" id="9fce-a2b3-5f14-50f0">
              <characteristics>
                <characteristic name="Descripción" typeId="2b3c-4ce9-3d0b-24d2">Dispersión de agentes químicos caseros.</characteristic>
                <characteristic name="Efecto" typeId="77dd-688d-97d4-78a1">Perfil de Ataque de Armas Químicas.</characteristic>
              </characteristics>
            </profile>
            <profile name="Nivel 6 - Levantamiento Coordinado" typeId="9bc6-e12d-f350-b01a" typeName="Escaladas" hidden="false" id="671b-3f7b-cdcb-c96e">
              <characteristics>
                <characteristic name="Descripción" typeId="2b3c-4ce9-3d0b-24d2">Todas las Unidades de la Milicia gana +2 de Momentum en este turno</characteristic>
                <characteristic name="Efecto" typeId="77dd-688d-97d4-78a1">Mayor caos, mayor peligro.</characteristic>
              </characteristics>
            </profile>
            <profile name="Nivel 6 - Pánico Generalizado" typeId="9bc6-e12d-f350-b01a" typeName="Escaladas" hidden="false" id="0db9-5548-f8fb-4d2e">
              <characteristics>
                <characteristic name="Descripción" typeId="2b3c-4ce9-3d0b-24d2">Los civiles empiezan a huir. Las fuerzas del orden u otras facciones pueden intervenir.</characteristic>
                <characteristic name="Efecto" typeId="77dd-688d-97d4-78a1">Todas las unidades Civiles realizan una tirada de Comportamiento Hostil. Todas las Unidades enemigas realizan un Test de Estrés.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <entryLinks>
