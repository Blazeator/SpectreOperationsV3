                <characteristic name="Efecto" typeId="77dd-688d-97d4-78a1">Una Unidad de 8 civiles Hostiles. Colócala a 2&quot; de cualquier terreno. Aplica Reglas de Refuerzos.</characteristic>
              </characteristics>
